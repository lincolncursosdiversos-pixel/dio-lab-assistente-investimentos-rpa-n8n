    {
      "parameters": {
        "jsCode": "let result = []\n\nfor (let c of $input.first().json.body.clientes ) {\n\n  let novo_cliente = {} \n  let saldoLimpo = String(c.saldo || \"0\").replace(/[^\\d]/g, \"\");\n  let saldo = Number(saldoLimpo) / 100 || 0; \n\n  novo_cliente['headers'] = $input.first().json.headers\n  novo_cliente['cliente'] = c \n\n  let investimentos_possiveis = []\n\n  let possiveis_investimentos = $input.first().json.investimentos.filter( el => {\n    let minimo = Number(el.minimo)\n    \n    return saldo > minimo\n  })\n\n  possiveis_investimentos.sort((a, b) => Number(b.minimo) - Number(a.minimo));\n\n  novo_cliente['investimento_recomendado'] = possiveis_investimentos[0]\n\n  result.push(novo_cliente)\n\n}\n\nreturn { items : result };\n"
      },
